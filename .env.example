PORT=3000
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
# token lifetimes in seconds (15 min / 7 days)
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
UPLOAD_DIR=./uploads
# used to sign the presigned urls
STORAGE_SIGNING_SECRET=change-me-signing-secret-at-least-32-characters
# presigned url lifetime in seconds
PRESIGNED_URL_TTL=300
# optional, used when building presigned urls (default http://localhost:PORT)
# PUBLIC_BASE_URL=https://api.example.com
